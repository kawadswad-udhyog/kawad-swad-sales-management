# Copy this file to .env only on your own computer. Do not upload .env.
# Do not put real passwords, spreadsheet IDs, or service-account JSON in this example.

# Frontend build setting. Use the public address of your FastAPI backend.
VITE_API_URL=https://your-backend.example.com

# Backend settings belong in the host's environment, not in this frontend file.
# SALES_GOOGLE_SPREADSHEET_ID=
# SALES_GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/sales-service-account.json
# SALES_JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
# SALES_CORS_ORIGINS=https://your-frontend.example.com,http://localhost:3000
# SALES_TOKEN_HOURS=8
# SALES_ENV=production
